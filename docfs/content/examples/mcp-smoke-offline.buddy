# Offline smoke: profile payload patch path agents should use via MCP.
def main():
    xml = """<?xml version="1.0"?><os_x_configuration_profile><general><id>1</id></general><payloads>&lt;?xml version="1.0"?&gt;&lt;plist version="1.0"&gt;&lt;dict&gt;&lt;key&gt;PayloadContent&lt;/key&gt;&lt;array&gt;&lt;dict&gt;&lt;key&gt;PayloadIdentifier&lt;/key&gt;&lt;string&gt;com.example.test&lt;/string&gt;&lt;key&gt;PayloadType&lt;/key&gt;&lt;string&gt;com.example.test&lt;/string&gt;&lt;key&gt;SomeKey&lt;/key&gt;&lt;string&gt;Old&lt;/string&gt;&lt;/dict&gt;&lt;/array&gt;&lt;/dict&gt;&lt;/plist&gt;</payloads></os_x_configuration_profile>"""
    patched = profile_xml_patch_payload(
        xml,
        "com.example.test",
        {
            "PayloadIdentifier": "com.example.test",
            "PayloadType": "com.example.test",
            "SomeKey": "New",
        },
    )
    payloads = profile_xml_extract_payloads(patched)
    if "New" not in payloads:
        fail("patch did not apply")
    # Group helper builtins must be registered (MCP wraps these).
    _ = smart_group_get_criteria
    _ = static_group_list_computers
    print("mcp-smoke-offline: ok")
    return None
