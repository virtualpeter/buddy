#!/usr/bin/env buddy
# demochange.buddy — easiest change-batch starter (edit SETUP, then plan / apply).
# Same shape as change-batch-santa.buddy, with placeholders instead of a real app.
#
# Usage:
#   buddy examples/demochange.buddy              # plan only (default)
#   buddy examples/demochange.buddy -- apply     # plan + apply (after approval)
#   buddy -y examples/demochange.buddy -- apply  # apply without prompts
#
# Howto: docs/change-batches.md

def main():
    # ===================== SETUP (edit me) =====================
    # Change metadata
    TITLE   = "App 2.0 cache + install rollout"
    SUMMARY = """Create versioned cache for 2.0; replace install-app-next.
Self Service already calls install-app-next."""
    RISK    = "low"
    WINDOW  = "2026-07-28 22:00–23:00"

    # App + versions
    APP     = "app"
    VERSION = "2.0"

    # Triggers / package matching
    CACHE_TRIGGER   = "cache-app-1.0"
    INSTALL_TRIGGER = "install-app-next"
    PACKAGE_PATTERN = "*app*2.0*"

    # Step notes
    CACHE_NOTE   = "Versioned cache; leave 1.0 cache enabled for rollback."
    INSTALL_NOTE = "Unversioned install-next replacement; disable prior install policy."
    SS_NOTE      = "Self Service already invokes install-app-next; no SS edit."
    # ===========================================================

    mode = "plan"
    if len(args) > 0 and args[0] in ("apply", "run"):
        mode = "apply"

    change = change_batch(
        title = TITLE,
        summary = SUMMARY,
        risk = RISK,
        window = WINDOW,
    )

    steps = [
        step_set_package(
            name = APP,
            version = VERSION,
            from_trigger = CACHE_TRIGGER,
            package_pattern = PACKAGE_PATTERN,
            note = CACHE_NOTE,
        ),
        step_set_package(
            name = APP,
            version = VERSION,
            from_trigger = INSTALL_TRIGGER,
            package_pattern = PACKAGE_PATTERN,
            note = INSTALL_NOTE,
        ),
        step_note(
            note = SS_NOTE,
        ),
    ]

    planned = plan_change(change = change, steps = steps)

    if mode != "apply":
        print("Plan only. Re-run with: buddy examples/demochange.buddy -- apply")
        return

    run_change(change = change, steps = steps, planned = planned)
