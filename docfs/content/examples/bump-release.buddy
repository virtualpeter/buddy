#!/usr/bin/env buddy
# bump-release.buddy — illustrative release bump (edit constants for your Jamf tenant)
#
# Usage:
#   ./examples/bump-release.buddy -- 2.4.27
#   buddy examples/bump-release.buddy -- 2.4.27

# --- edit for your environment ---
TRIGGER_PREFIX = "install-exampleapp-"
PACKAGE_NAME = "exampleapp"

# Policies found by trigger above often cover package + install + self-service together.
# If yours differ, set these to the other policies' numeric IDs.
INSTALL_POLICY_ID = 0   # 0 = use the resolved policy for install
SELF_SERVICE_POLICY_ID = 0  # 0 = use the resolved policy for self-service
VERSION_GROUP_ID = ""   # smart group ID string, or "" = skip smart_group_set_version


def _session_kwargs(tenant = None, surface = None, auth = None):
    out = {}
    if tenant != None and tenant != "":
        out["tenant"] = tenant
    if surface != None and surface != "":
        out["surface"] = surface
    if auth != None and auth != "":
        out["auth"] = auth
    return out


# Resolve policy by trigger, set package / install / self-service, optional smart-group version.
# Returns {"policy_id": int}. Builtin failures raise.
def bump_release(
        trigger_prefix,
        name,
        version,
        install_policy_id = 0,
        self_service_policy_id = 0,
        version_group_id = "",
        tenant = None,
        surface = None,
        auth = None):
    sk = _session_kwargs(tenant = tenant, surface = surface, auth = auth)
    trigger = trigger_prefix + version

    policy_id = policy(trigger = trigger, **sk)["id"]
    policy_set_package(name = name, version = version, policy_id = policy_id, **sk)

    install_id = install_policy_id if install_policy_id else policy_id
    policy_set_install(policy_id = install_id, version = version, **sk)

    ss_id = self_service_policy_id if self_service_policy_id else policy_id
    policy_set_ss(policy_id = ss_id, version = version, **sk)

    if version_group_id:
        smart_group_set_version(group_id = version_group_id, version = version, **sk)

    return {"policy_id": policy_id}


def main():
    if len(args) < 1:
        error("Usage: buddy examples/bump-release.buddy -- <version>")
        exit(1)

    version = args[0]
    out = bump_release(
        trigger_prefix = TRIGGER_PREFIX,
        name = PACKAGE_NAME,
        version = version,
        install_policy_id = INSTALL_POLICY_ID,
        self_service_policy_id = SELF_SERVICE_POLICY_ID,
        version_group_id = VERSION_GROUP_ID,
    )

    error("Done. Bumped to", version, "policy_id=", out["policy_id"])
