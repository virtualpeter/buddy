# stdlib/app_setup.buddy — Classic greenfield “new app” change-batch steps.
#
# load("stdlib/app_setup.buddy", "setup_app_classic")
#
# Returns a list of step dicts for plan_change / run_change. Does not write to Jamf.

def _require_ok(r, label):
    if not r["ok"]:
        fail(label + ": " + r["error"])
    return r["value"]

# setup_app_classic — build prefs + PPPC profiles, cache/install policies, optional SS steps.
#
# Returns list of step dicts (prefs profile → PPPC profile → cache → install → optional SS → notes).
def setup_app_classic(
        app,
        version,
        prefs_content,
        pppc_services = None,
        pppc_payload_dict = None,
        package_pattern = "",
        create_ss = False,
        ss_display_name = "",
        ss_script_id = 0,
        scope_all = True,
        scope_group_ids = None,
        category = "",
        prefs_profile_name = "",
        pppc_profile_name = ""):
    """Compose Classic new-app change-batch steps (profiles + cache/install + optional SS)."""
    if prefs_content == None or len(prefs_content) == 0:
        fail("setup_app_classic requires prefs_content (list of payload dicts)")

    groups = scope_group_ids if scope_group_ids != None else []
    title = app
    if len(app) > 0:
        title = app[0:1].upper() + app[1:]

    prefs_name = prefs_profile_name if prefs_profile_name else (title + " Preferences")
    pppc_name = pppc_profile_name if pppc_profile_name else (title + " PPPC")

    steps = [
        step_create_profile(
            name = prefs_name,
            content = prefs_content,
            scope_all = scope_all,
            scope_group_ids = groups,
            category = category,
            note = "Prefs / MCX configuration profile for " + app + ".",
        ),
    ]

    pppc = pppc_payload_dict
    if pppc == None:
        if pppc_services == None:
            fail("setup_app_classic requires pppc_services or pppc_payload_dict")
        pppc = _require_ok(pppc_payload(services = pppc_services), "pppc_payload")

    steps.append(step_create_profile(
        name = pppc_name,
        content = [pppc],
        scope_all = scope_all,
        scope_group_ids = groups,
        category = category,
        note = "PPPC (TCC) profile for " + app + ".",
    ))

    steps.append(step_create_package_policy(
        app = app,
        version = version,
        action = "cache",
        package_pattern = package_pattern,
        scope_all = scope_all,
        scope_group_ids = groups,
        category = category,
        note = "Versioned cache policy cache-" + app.lower() + "-" + version + ".",
    ))
    steps.append(step_create_package_policy(
        app = app,
        version = version,
        action = "install",
        package_pattern = package_pattern,
        scope_all = scope_all,
        scope_group_ids = groups,
        category = category,
        note = "Unversioned install trigger install-" + app.lower() + "-next.",
    ))

    install_trigger = "install-" + app.lower() + "-next"
    if create_ss:
        display = ss_display_name if ss_display_name else ("Install " + title)
        steps.append(step_create_ss(
            trigger = install_trigger,
            display_name = display,
            category = category,
            script_id = ss_script_id,
            note = "Self Service invokes " + install_trigger + " via script parameter4.",
        ))
    else:
        steps.append(step_note(
            note = "No Self Service policy created. Point SS at trigger " + install_trigger + " when ready.",
        ))

    steps.append(step_note(
        note = "Created IDs appear in Outcomes after apply. Scope default is all computers unless scope_group_ids set.",
    ))
    return steps
