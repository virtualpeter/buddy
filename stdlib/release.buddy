# stdlib/release.buddy — multi-step release helpers composed from buddy builtins.
#
# load("stdlib/release.buddy", "bump_release")

def _session_kwargs(tenant = None, surface = None, auth = None):
    out = {}
    if tenant != None and tenant != "":
        out["tenant"] = tenant
    if surface != None and surface != "":
        out["surface"] = surface
    if auth != None and auth != "":
        out["auth"] = auth
    return out

# bump_release — resolve policy by trigger, set package/install/SS, optional smart-group version.
#
# Returns {"policy_id": int}. Builtin failures raise.
def bump_release(
        trigger_prefix,
        app,
        version,
        install_policy_id = 0,
        self_service_policy_id = 0,
        version_group_id = "",
        tenant = None,
        surface = None,
        auth = None):
    """Bump an app release: package + install + self-service (+ optional version group)."""
    sk = _session_kwargs(tenant = tenant, surface = surface, auth = auth)
    trigger = trigger_prefix + version

    policy_id = policy(trigger = trigger, force_refresh = True, **sk)["id"]
    policy_set_package(app = app, version = version, policy_id = policy_id, **sk)

    install_id = install_policy_id if install_policy_id else policy_id
    policy_set_install(policy_id = install_id, version = version, **sk)

    ss_id = self_service_policy_id if self_service_policy_id else policy_id
    policy_set_ss(policy_id = ss_id, version = version, **sk)

    if version_group_id:
        smart_group_set_version(group_id = version_group_id, version = version, **sk)

    return {"policy_id": policy_id}
